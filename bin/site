#!/bin/sh
# One entry point for this site's isolated local environment.
set -eu
cd "$(dirname "$0")/.."
site_root="$PWD"
if [ ! -x "$site_root/.local/ruby/bin/ruby" ]; then
  echo "Local environment is missing. Run: python3 bin/setup-local.py" >&2
  exit 1
fi
unset RUBYLIB RUBYOPT DYLD_LIBRARY_PATH BUNDLE_BIN_PATH BUNDLE_GEMFILE GEM_PATH
export PATH="$site_root/.local/gems/bin:$site_root/.local/ruby/bin:$site_root/.local/node/bin:$PATH"
export GEM_HOME="$site_root/.local/gems"
export BUNDLE_PATH="$site_root/.local/bundle"
export BUNDLE_APP_CONFIG="$site_root/.local/bundle-config"
export BUNDLE_USER_HOME="$site_root/.local/bundler-home"
export BUNDLE_FROZEN=true
export SSL_CERT_FILE=/etc/ssl/cert.pem
export npm_config_cache="$site_root/.local/npm-cache"
command_name="${1:-serve}"
if [ "$#" -gt 0 ]; then shift; fi
case "$command_name" in
  build) exec bundle exec jekyll build "$@" ;;
  serve) exec bundle exec jekyll serve --host 127.0.0.1 --port 4000 --force_polling "$@" ;;
  check)
    bundle check
    exec ruby bin/check-site.rb "$@"
    ;;
  format-check) exec npm run lint:prettier ;;
  audit) exec bundle exec al-folio upgrade overrides audit "$@" ;;
  bundle) exec bundle "$@" ;;
  *) echo "Usage: bin/site {build|serve|check|format-check|audit|bundle}" >&2; exit 2 ;;
esac
